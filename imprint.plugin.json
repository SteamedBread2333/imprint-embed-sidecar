{
  "apiVersion": 1,
  "id": "embed",
  "name": "imprint-embed-plugin",
  "version": "0.1.0",
  "capabilities": ["embed"],
  "entry": {
    "start": "./run.sh",
    "health": "GET http://127.0.0.1:${port}/health"
  },
  "configSchema": {
    "port": { "type": "number", "default": 4174 },
    "model": { "type": "string", "default": "BAAI/bge-small-zh-v1.5" },
    "timeout_seconds": { "type": "number", "default": 2 },
    "duplicate_threshold": { "type": "number", "default": 0.70 }
  },
  "tools": []
}
